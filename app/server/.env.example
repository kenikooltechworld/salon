APP_NAME=Salon API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=https://kenikoolsalon.com
PLATFORM_DOMAIN=kenikoolsalon.com
CORS_ORIGINS=https://kenikoolsalon.com,https://www.kenikoolsalon.com,https://api.kenikoolsalon.com
# Neon PostgreSQL (set in Render/production). Example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudinary (Media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PLATFORM_FEE_PERCENTAGE=10.0
